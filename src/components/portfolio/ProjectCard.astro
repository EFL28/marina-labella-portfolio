---
import type { Project } from '../../data/projects';

type Props = {
	project: Project;
	priority?: boolean;
};

const { project, priority = false } = Astro.props;
const href = `/${project.section}/${project.slug}`;
const media = project.mediaPlaceholders[0];
---

<a class="project-card" href={href} aria-label={`View ${project.title}`}>
	<div
		class:list={['project-card__media', `tone-${media.tone}`]}
		style={`aspect-ratio: ${media.aspectRatio}`}
		data-priority={priority}
	>
		<span>{project.title}</span>
	</div>
	<div class="project-card__copy">
		<h2>{project.title}</h2>
		<p>{project.category}</p>
	</div>
</a>
