---
/**
 * Inline SVG icon. Inherits the text colour (`currentColor`) and scales with
 * the font size (1em) unless `size` is given.
 *
 * Decorative by default (aria-hidden). Pass `label` when the icon is the only
 * content of a link/button and has no visible text, e.g.
 *   <a href="…"><Icon name="instagram" label="Instagram" /></a>
 */
interface Props {
	name: IconName;
	label?: string;
	size?: string;
	class?: string;
}

const icons = {
	instagram: `
		<rect x="3" y="3" width="18" height="18" rx="5" />
		<circle cx="12" cy="12" r="4" />
		<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />`,
	linkedin: `
		<rect x="3" y="3" width="18" height="18" rx="3" />
		<path d="M8 10.5V16" />
		<circle cx="8" cy="7.4" r="1.1" fill="currentColor" stroke="none" />
		<path d="M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.4-2.6 1.4 0 2.1.9 2.1 2.6V16" />`,
	vimeo: `
		<path d="M3 8.3c.9-.8 3-2.9 4.3-3 1.6-.2 2 2.4 2.4 4.4.4 1.8.7 3.5 1.3 3.5.7 0 2.6-3.3 2.7-4.3.1-1-.7-1.5-2.1-.9.8-2.6 2.6-3.6 4.5-3.5 2 .1 2.6 1.6 2.2 3.7-.6 3.4-5 9.3-7.4 9.3-1.9 0-2.6-3.3-3.4-6.4-.4-1.6-.8-3.7-1.7-3.7-.4 0-1.2.7-1.9 1.3" />`,
	behance: `
		<path d="M2.5 6.5h4.8a2.4 2.4 0 0 1 0 4.8H2.5zM2.5 11.3h5.3a2.6 2.6 0 0 1 0 5.2H2.5z" />
		<path d="M14.2 13.6h7.1a3.55 3.55 0 1 0-1 2.5" />
		<path d="M15 8h5" />`,
	mail: `
		<rect x="3" y="5" width="18" height="14" rx="2" />
		<path d="m3.5 6.5 8.5 6.5 8.5-6.5" />`,
	menu: `<path d="M4 7h16M4 12h16M4 17h16" />`,
	close: `<path d="M6 6l12 12M18 6 6 18" />`,
} as const;

export type IconName = keyof typeof icons;

const { name, label, size = '1em', class: className } = Astro.props;
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
	set:html={icons[name]}
/>

<style>
	.icon {
		display: inline-block;
		flex-shrink: 0;
		vertical-align: middle;
	}
</style>
