---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="About - Marina Labella"
	description="About Marina Labella, illustrator and animation artist."
	currentPath="/about"
>
	<section class="page">
		<div class="hero hero--compact">
			<div>
				<p class="eyebrow">About</p>
				<h1>Hello</h1>
			</div>
		</div>

		<div class="about-grid">
			<div class="prose">
				<p>
					<strong>Marina Labella</strong> is an illustrator and animation artist. This page is a
					structured placeholder for the final biography, services, client list and press text.
				</p>
				<p>
					The layout is intentionally editorial and image-led, so final copy can be added without
					changing the page architecture.
				</p>
			</div>
			<aside class="note-panel">
				<p>Available for illustration, visual storytelling and animation projects.</p>
				<p><a class="text-link" href="mailto:marinaf.labella@gmail.com">marinaf.labella@gmail.com</a></p>
			</aside>
		</div>
	</section>
</Layout>
